# Public (browser-safe). From Supabase: Project Settings -> API, or `npx supabase status` locally.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: the app's public URL, used in account-setup email links.
# Defaults to the request origin. Must be in Supabase Auth's redirect allowlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY secret. Used by the organizer's "Add approved participant" workflow
# (creating logins, sending setup emails) and by scripts/seed.mts and the tests.
# In Vercel, add it as a server environment variable; never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Password given to seeded demo accounts (dev only, min 8 chars).
SEED_PASSWORD=choose-a-dev-password

# Optional: organizer support email shown on the Help page. No direct contact is
# published on the official event page, so leave this empty until the organizers
# confirm one; Help then links to https://jocellebatapasigue.com/b2bcafe/ only.
ORGANIZER_CONTACT_EMAIL=
